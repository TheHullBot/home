---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollTop from '../../components/ScrollTop.astro';
import PolicyDialog from '../../components/PolicyDialog.astro';
import { articles, articleUrl } from '../../data/articles';

const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.title,
    url: `https://hullbot.group${articleUrl(a.slug)}`,
  })),
};
---

<Base
  title="Статьи об очистке корпуса и экономике флота | ХаллБот Групп"
  description="Разборы для судовладельцев и суперинтендантов: во что обходится обрастание, когда нужен док, как корпус влияет на рейтинг CII. Цифры, формулы и источники."
>
  <Header />

  <main id="main" class="mx-auto max-w-7xl px-5 pt-28 pb-20 lg:px-8 lg:pt-36">
    <script type="application/ld+json" set:html={JSON.stringify(list)} />

    <header class="max-w-3xl">
      <p class="mb-4 flex items-center gap-3 text-sm font-medium tracking-[0.2em] text-signal-500 uppercase">
        <span class="h-px w-8 bg-signal-500"></span>
        Статьи
      </p>
      <h1 class="text-[length:var(--text-display)] leading-tight font-bold tracking-tight text-balance">
        Экономика чистого корпуса
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-foam-300 text-pretty">
        Разборы для судовладельцев и суперинтендантов: цифры, формулы и ссылки на
        первоисточники вместо обещаний.
      </p>
    </header>

    <ul class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-3">
      {articles.map((a) => (
        <li>
          <a
            href={articleUrl(a.slug)}
            class="flex h-full flex-col rounded-2xl border border-white/10 bg-abyss-900 p-7 transition-colors hover:border-signal-500/60"
          >
            <p class="text-sm text-foam-500">
              <time datetime={a.updated}>
                {new Date(a.updated).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <span aria-hidden="true"> · </span>
              {a.readingMinutes} мин
            </p>
            <h2 class="mt-3 text-lg leading-snug font-bold text-foam-100">{a.title}</h2>
            <p class="mt-3 grow text-sm leading-relaxed text-foam-400">{a.description}</p>
            <span class="mt-5 text-sm font-semibold text-signal-500">Читать</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
  <PolicyDialog />
  <ScrollTop />
</Base>
