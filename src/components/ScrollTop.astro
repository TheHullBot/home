---
// Страница длинная, а меню при прокрутке остаётся сверху — но вернуться
// к первому экрану и форме одним движением было нечем.
---

<button
  id="scroll-top"
  type="button"
  aria-label="Наверх"
  class="fixed right-5 bottom-24 z-30 flex h-11 w-11 translate-y-3 items-center justify-center rounded-full
         border border-white/15 bg-abyss-900/90 text-foam-100 opacity-0 shadow-lg shadow-abyss-950/50
         backdrop-blur-sm transition-all duration-300 hover:border-white/40 hover:bg-abyss-800
         sm:right-6 sm:bottom-6"
  hidden
>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M9 14V4M4 9l5-5 5 5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const button = document.getElementById('scroll-top');

  if (button) {
    const show = () => {
      const past = window.scrollY > window.innerHeight * 1.2;
      if (past) {
        button.hidden = false;
        // hidden снимается раньше, иначе переход не проигрывается
        requestAnimationFrame(() => button.classList.remove('opacity-0', 'translate-y-3'));
      } else {
        button.classList.add('opacity-0', 'translate-y-3');
        setTimeout(() => {
          if (window.scrollY <= window.innerHeight * 1.2) button.hidden = true;
        }, 300);
      }
    };

    show();
    window.addEventListener('scroll', show, { passive: true });

    button.addEventListener('click', () => {
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
    });
  }
</script>
