---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import disc from '../assets/eq-disc.png';
import gun from '../assets/eq-gun.png';
import pump from '../assets/eq-pump.png';
import control from '../assets/eq-control.png';
import cables from '../assets/eq-cables.png';

// Раньше это была строка из пяти карточек с фотографиями и занимала целый
// экран. Содержание вспомогательное, поэтому фотографии убраны в окно,
// а на странице остались только названия.
const items = [
  { img: disc, label: 'Кавитационный струйный диск' },
  { img: gun, label: 'Кавитационный пистолет' },
  { img: pump, label: 'Трансформатор и насосная станция' },
  { img: control, label: 'Система эксплуатации и контроля' },
  { img: cables, label: 'Силовой и U-образный кабели' },
];
---

<Section
  eyebrow="Оснащение"
  title="Вспомогательные системы и оборудование"
  lead="Комплекс приезжает на объект целиком: от рабочего инструмента до питания, управления и кабельного хозяйства."
>
  <button
    type="button"
    data-eq
    class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-abyss-900 px-6 py-3
           text-sm font-medium text-foam-100 transition-colors hover:border-signal-500/60 hover:bg-abyss-800"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" class="text-signal-500" aria-hidden="true">
      <rect x="1.5" y="3" width="13" height="10" rx="1.5" />
      <circle cx="5.2" cy="6.4" r="1.1" />
      <path d="M2.2 11.5l3.6-3.4 2.7 2.5 2.7-2.6 2.6 2.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    Посмотреть оснащение
  </button>

  <dialog
    id="eq-dialog"
    class="m-auto max-h-[90vh] max-w-[min(92vw,54rem)] rounded-2xl border border-white/10 bg-abyss-900 p-0
           backdrop:bg-abyss-950/85 backdrop:backdrop-blur-sm"
    aria-label="Вспомогательное оборудование"
  >
    <div class="flex items-center justify-between gap-4 border-b border-white/10 px-6 py-4">
      <p class="text-sm font-semibold text-foam-100">Вспомогательные системы и оборудование</p>
      <button
        type="button"
        data-eq-close
        aria-label="Закрыть"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-foam-300 transition-colors hover:bg-white/10 hover:text-white"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <ul class="grid max-h-[calc(90vh-4.25rem)] gap-4 overflow-auto p-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((it, i) => (
        <li id={`eq-item-${i}`} class="rounded-xl border border-white/10 bg-abyss-950/40 p-4">
          <Image
            src={it.img}
            alt={it.label}
            widths={[240, 480]}
            sizes="(min-width: 1024px) 16rem, 45vw"
            loading="lazy"
            class="mx-auto h-32 w-auto object-contain"
          />
          <p class="mt-4 text-sm leading-snug font-medium text-foam-100">{it.label}</p>
        </li>
      ))}
    </ul>
  </dialog>
</Section>

<script>
  const dialog = document.getElementById('eq-dialog') as HTMLDialogElement | null;

  if (dialog) {
    document
      .querySelector<HTMLButtonElement>('[data-eq]')
      ?.addEventListener('click', () => dialog.showModal());

    dialog.querySelector('[data-eq-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
      if (outside) dialog.close();
    });
  }
</script>
