---
import Section from './Section.astro';
import { about, company, requisites } from '../content/site';
---

<Section
  id="about"
  eyebrow="О компании"
  title="Кто выполняет работы"
  lead={about.lead}
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {about.facts.map((f) => (
      <div class="rounded-2xl border border-white/10 bg-abyss-900 p-7">
        <p class="font-bold text-signal-500">{f.k}</p>
        <p class="mt-2.5 text-sm leading-relaxed text-foam-400">{f.v}</p>
      </div>
    ))}
  </div>

  <p class="mt-8 text-sm leading-relaxed text-foam-500">
    {company.legalName} · ОГРН {requisites.ogrn} · ИНН {requisites.inn}. Цена работ
    определяется по договорённости после данных об объекте: опишите судно в заявке,
    вернёмся с расчётом в течение рабочего дня.
  </p>
</Section>
