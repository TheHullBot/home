---
import { company, workScope } from '../content/site';

// Пока обработчика нет, форма собирает письмо в почтовой программе посетителя:
// данные не проходят ни через один сервер. Как только появится адрес обработчика,
// он подставится сюда, а письмо останется запасным путём.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';

const objectTypes = ['Судно', 'Спецтехника', 'Платформа', 'Мост', 'Пирс', 'Другое'];
const field =
  'w-full rounded-xl border border-white/15 bg-abyss-950/60 px-4 py-3 text-foam-100 ' +
  'placeholder:text-foam-500 transition-colors focus:border-signal-500 focus:outline-none';
const label = 'mb-2 block text-sm font-medium text-foam-300';
---

<section id="request" class="scroll-mt-24 border-y border-white/10 bg-abyss-900">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-2 lg:gap-20 lg:px-8 lg:py-28">
    <div>
      <p class="mb-4 flex items-center gap-3 text-sm font-medium tracking-[0.2em] text-signal-500 uppercase">
        <span class="h-px w-8 bg-signal-500"></span>
        Расчёт стоимости и срока
      </p>
      <h2 class="text-[length:var(--text-display)] leading-tight font-bold tracking-tight text-balance">
        Опишите объект, вернёмся со сроком и ценой
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-foam-300 text-pretty">
        Чем точнее данные об объекте, тем точнее расчёт. Если чего-то не знаете, оставьте поле
        пустым, уточним при разговоре.
      </p>

      <p class="mt-6 inline-flex items-center gap-2.5 rounded-full border border-signal-500/30 bg-signal-500/10 px-4 py-2 text-sm font-medium text-signal-400">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" />
          <path d="M8 4.5V8l2.5 1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Отвечаем в течение рабочего дня
      </p>

    </div>

    <form
      id="request-form"
      data-endpoint={endpoint}
      data-phone={company.phone}
      data-mail="info@hullbot.group"
      data-tel={company.phoneHref}
      novalidate
      class="space-y-5"
    >
      <!-- ловушка для ботов -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>Компания<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class={label} for="f-type">Тип объекта</label>
          <select id="f-type" name="type" class={field}>
            {objectTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div id="imo-field" hidden>
          <label class={label} for="f-imo">
            Номер IMO <span class="font-normal text-foam-500">(если знаете)</span>
          </label>
          <input
            id="f-imo"
            name="imo"
            type="text"
            inputmode="numeric"
            maxlength="7"
            pattern="[0-9]{7}"
            class={field}
            placeholder="9074729"
          />
        </div>
        <div>
          <label class={label} for="f-size">Размер</label>
          <input id="f-size" name="size" type="text" class={field} placeholder="длина 180 м или 4200 м²" />
        </div>
        <div>
          <label class={label} for="f-place">Порт или место стоянки</label>
          <input id="f-place" name="place" type="text" class={field} placeholder="Новороссийск, причал 12" />
        </div>
        <div>
          <label class={label} for="f-when">Даты стоянки</label>
          <input id="f-when" name="when" type="text" class={field} placeholder="подход 14 мая, отход 16 мая" />
        </div>
      </div>

      <fieldset>
        <legend class={label}>Что нужно сделать</legend>
        <div class="flex flex-wrap gap-2">
          {workScope.map((w) => (
            <label
              class="cursor-pointer rounded-full border border-white/15 bg-abyss-950/60 px-4 py-2 text-sm
                     text-foam-300 transition-colors has-checked:border-signal-500 has-checked:bg-signal-500/10
                     has-checked:text-signal-400"
            >
              <input type="checkbox" name="scope" value={w} class="sr-only" />
              {w}
            </label>
          ))}
        </div>
      </fieldset>

      <hr class="border-white/10" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class={label} for="f-name">Имя <span class="text-signal-500">*</span></label>
          <input
            id="f-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class={field}
            placeholder="Как к вам обращаться"
          />
        </div>
        <div>
          <label class={label} for="f-phone">Телефон <span class="text-signal-500">*</span></label>
          <input
            id="f-phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            class={field}
            placeholder="+7 900 000-00-00"
          />
        </div>
      </div>

      <div>
        <label class={label} for="f-email">Почта</label>
        <input
          id="f-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          class={field}
          placeholder="name@company.ru"
        />
      </div>

      <div>
        <label class={label} for="f-note">Что важно знать</label>
        <textarea id="f-note" name="note" rows="3" class={field} placeholder="Степень обрастания, предыдущая очистка, ограничения по времени"></textarea>
      </div>

      <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-foam-300">
        <input
          id="f-consent"
          name="consent"
          type="checkbox"
          required
          class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-white/25 bg-abyss-950 accent-signal-500"
        />
        <span>
          Даю согласие на обработку персональных данных в соответствии с{' '}
          <a href="/privacy/" class="text-signal-500 underline underline-offset-2 hover:text-signal-400">
            политикой обработки персональных данных</a>.
        </span>
      </label>

      <button
        type="submit"
        class="w-full rounded-full bg-signal-500 px-7 py-4 font-semibold text-abyss-950 transition-colors hover:bg-signal-400 disabled:opacity-60"
      >
        Отправить запрос
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden rounded-xl px-4 py-3 text-sm"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('request-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const endpoint = form.dataset.endpoint || '';
    const phone = form.dataset.phone || '';
    const tel = form.dataset.tel || '';
    const mail = form.dataset.mail || '';

    // Подписи полей повторяют серверный обработчик: письмо, собранное здесь,
    // и письмо, собранное функцией, должны читаться одинаково.
    const LABELS: [string, string][] = [
      ['type', 'Тип объекта'],
      ['imo', 'Номер IMO'],
      ['size', 'Размер'],
      ['scope', 'Объём работ'],
      ['place', 'Порт или место стоянки'],
      ['when', 'Даты стоянки'],
      ['name', 'Имя'],
      ['phone', 'Телефон'],
      ['email', 'Почта'],
      ['note', 'Комментарий'],
    ];

    // Запасной путь: письмо уходит из почтовой программы посетителя прямо на
    // info@, не проходя ни через один сервер. Нужен, пока не поднят обработчик,
    // и потом — когда обработчик недоступен.
    const mailFallback = (payload: Record<string, unknown>) => {
      const lines = LABELS.filter(([k]) => String(payload[k] ?? '').trim()).map(
        ([k, l]) => `${l}: ${String(payload[k]).trim()}`,
      );
      lines.push('Согласие на обработку персональных данных: да');
      const body = lines.join('\n').slice(0, 1500);
      const subject = 'Заявка с сайта hullbot.group';
      window.location.href =
        `mailto:${mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const typeSelect = form.querySelector<HTMLSelectElement>('#f-type');
    const imoField = document.getElementById('imo-field');

    // Номер IMO есть только у судов: для пирса или моста поле лишнее
    const toggleImo = () => {
      if (imoField && typeSelect) imoField.hidden = typeSelect.value !== 'Судно';
    };
    toggleImo();
    typeSelect?.addEventListener('change', toggleImo);

    const markBad = (el: HTMLElement | null) => el?.classList.add('border-red-400/70');
    const clearBad = () =>
      form.querySelectorAll('.border-red-400\\/70').forEach((el) => el.classList.remove('border-red-400/70'));

    // withPhone дописывает номер ссылкой: с телефона по нему звонят в одно касание,
    // а простой текст пришлось бы выделять и копировать
    const say = (kind: 'ok' | 'err', text: string, withPhone = false) => {
      status.className =
        kind === 'ok'
          ? 'rounded-xl bg-signal-500/15 px-4 py-3 text-sm text-signal-400'
          : 'rounded-xl bg-red-500/15 px-4 py-3 text-sm text-red-300';
      status.textContent = text;
      if (withPhone && phone) {
        const a = document.createElement('a');
        a.href = `tel:${tel}`;
        a.textContent = phone;
        a.className = 'font-semibold whitespace-nowrap underline underline-offset-2 hover:text-white';
        status.append(' ', a);
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      clearBad();
      const consent = form.querySelector<HTMLInputElement>('#f-consent');
      const name = form.querySelector<HTMLInputElement>('#f-name');
      const phoneInput = form.querySelector<HTMLInputElement>('#f-phone');

      // Подсказываем конкретно, что не так, а не общей фразой на всю форму
      const missing: string[] = [];
      if (!name?.value.trim()) { markBad(name); missing.push('имя'); }
      if (!phoneInput?.value.trim()) { markBad(phoneInput); missing.push('телефон'); }
      if (missing.length) {
        say('err', `Не хватает: ${missing.join(' и ')}.`);
        (missing[0] === 'имя' ? name : phoneInput)?.focus();
        return;
      }
      if (!consent?.checked) {
        say('err', 'Отметьте согласие на обработку персональных данных.');
        consent?.focus();
        return;
      }
      if (!form.checkValidity()) {
        say('err', 'Проверьте выделенные поля.');
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      const payload: Record<string, unknown> = Object.fromEntries(data.entries());
      // чекбоксов может быть несколько, из entries придёт только последний
      payload.scope = data.getAll('scope').join(', ');
      payload.consent = true;

      if (!endpoint) {
        mailFallback(payload);
        say(
          'ok',
          'Заявка собрана в письмо, осталось нажать «Отправить» в почте. Если письмо не открылось, позвоните:',
          true,
        );
        return;
      }

      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'Отправляем…';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('ok', 'Заявка ушла. Свяжемся с вами при первой возможности.');
      } catch {
        mailFallback(payload);
        say('err', 'Отправить с сайта не вышло, заявка собрана в письмо. Или позвоните:', true);
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  }
</script>
