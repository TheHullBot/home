---
import Section from './Section.astro';
import { faq } from '../content/site';
---

<Section id="faq" eyebrow="Вопросы и ответы" title="Что обычно спрашивают до первой заявки">
  <div class="divide-y divide-white/10 border-y border-white/10">
    {faq.map((item) => (
      <details class="group py-5">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold marker:content-none"
        >
          <span>{item.q}</span>
          <span
            aria-hidden="true"
            class="mt-1 shrink-0 text-signal-500 transition-transform duration-200 group-open:rotate-45"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 4v12M4 10h12" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <p class="mt-3.5 max-w-3xl leading-relaxed text-foam-300">{item.a}</p>
      </details>
    ))}
  </div>
</Section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })}
/>
