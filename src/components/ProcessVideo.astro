---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { media } from '../media';

import processPoster from '../assets/process-poster.png';
import launchPoster from '../assets/insp-launch-poster.png';
import sonarPoster from '../assets/insp-sonar-poster.png';
import cameraSonarPoster from '../assets/insp-camera-sonar-poster.png';
import consolePoster from '../assets/insp-console-poster.png';
import robotPoster from '../assets/insp-robot-poster.png';
import sonarScreen from '../assets/insp-sonar-screen.png';

// Съёмка с объекта: смена на корпусе судна и испытания инспекционного
// комплекса в июне 2026. Звук снят намеренно — в записи слышны разговоры,
// фрагменты подобраны без людей в кадре.
const clips = [
  {
    file: 'process.mp4',
    poster: processPoster,
    label: 'Кавитационная очистка корпуса',
    note: 'Струя снимает обрастание, за аппаратом остаётся чистая полоса.',
  },
  {
    file: 'insp-camera-sonar.mp4',
    poster: cameraSonarPoster,
    label: 'Камера не видит, гидролокатор видит',
    note: 'Один пост оператора: слева обзор гидролокатора, справа камера в мутной воде.',
  },
  {
    file: 'insp-sonar.mp4',
    poster: sonarPoster,
    label: 'Цель на дистанции два метра',
    note: 'Сетка дальности на экране: оператор снимает расстояние до объекта прямо с картинки.',
  },
  {
    file: 'insp-launch.mp4',
    poster: launchPoster,
    label: 'Спуск аппарата с причала',
    note: 'Инспекционный робот уходит под воду, кабель-трос остаётся на причале.',
  },
  {
    file: 'insp-robot.mp4',
    poster: robotPoster,
    label: 'Инспекционный робот вблизи',
    note: 'Движители, камера и крепление гидролокатора перед спуском.',
  },
  {
    file: 'insp-console.mp4',
    poster: consolePoster,
    label: 'Пост оператора',
    note: 'Положение аппарата, курс и глубина выводятся рядом с картинкой с камер.',
  },
];
---

<Section
  id="video"
  eyebrow="Съёмка с объекта"
  title="Как это выглядит на самом деле"
  lead="Не визуализация, а рабочая съёмка: кавитационная струя на корпусе судна и приёмочные испытания инспекционного комплекса. Видно главное про осмотр: вода мутная, камера в ней почти бесполезна, а гидролокатор показывает корпус и предметы рядом с ним."
>
  {/* Снимок почти квадратный: во всю ширину он съедал бы целый экран,
      поэтому идёт колонкой рядом с подписью. */}
  <figure
    class="mb-12 grid items-center gap-6 rounded-2xl border border-white/10 bg-abyss-900 p-5
           sm:p-7 lg:grid-cols-[minmax(0,28rem)_1fr] lg:gap-10"
  >
    <Image
      src={sonarScreen}
      alt="Экран гидролокатора: сектор обзора с сеткой дальности от 0,5 до 3 метров, ярким пятном показан корпус судна"
      widths={[448, 896]}
      sizes="(min-width: 1024px) 28rem, 88vw"
      loading="lazy"
      class="w-full rounded-xl"
    />
    <figcaption class="leading-relaxed text-foam-400">
      Так корпус выглядит на экране гидролокатора. Сектор размечен по дальности от 0,5 до 3 метров:
      расстояние до объекта оператор снимает прямо с картинки, не подходя к нему вплотную.
      В мутной воде это единственный способ увидеть подводную часть целиком, а не пятно
      в свете фонаря.
    </figcaption>
  </figure>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {clips.map((clip, i) => (
      <li>
        <button
          type="button"
          data-clip={i}
          class="group block w-full overflow-hidden rounded-2xl border border-white/10 bg-abyss-900
                 text-left transition-colors hover:border-signal-500/60"
        >
          <span class="relative block">
            <Image
              src={clip.poster}
              alt={clip.label}
              widths={[380, 760]}
              sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 92vw"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
            <span
              class="absolute inset-0 flex items-center justify-center bg-abyss-950/30 transition-colors
                     group-hover:bg-abyss-950/10"
            >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-full bg-abyss-950/70
                       text-foam-100 backdrop-blur-sm transition-colors group-hover:bg-signal-500
                       group-hover:text-abyss-950"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M5 3.2v9.6l8-4.8z" />
                </svg>
              </span>
            </span>
          </span>
          <span class="block px-5 py-4">
            <span class="block font-semibold text-foam-100">{clip.label}</span>
            <span class="mt-1.5 block text-sm leading-relaxed text-foam-400">{clip.note}</span>
          </span>
        </button>
      </li>
    ))}
  </ul>

  <p class="mt-6 text-sm text-foam-500">
    Ролики без звука, загружаются только по нажатию.
  </p>

  <dialog
    id="clip-dialog"
    class="m-auto max-h-[92vh] max-w-[min(94vw,56rem)] rounded-2xl border border-white/10 bg-abyss-900 p-0
           backdrop:bg-abyss-950/85 backdrop:backdrop-blur-sm"
    aria-labelledby="clip-dialog-title"
  >
    <div class="flex items-center justify-between gap-4 border-b border-white/10 px-6 py-4">
      <p id="clip-dialog-title" class="text-sm font-semibold text-foam-100">Съёмка с объекта</p>
      <button
        type="button"
        data-clip-close
        aria-label="Закрыть"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-foam-300 transition-colors hover:bg-white/10 hover:text-white"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="p-4 sm:p-5">
      <video
        id="clip-player"
        class="mx-auto max-h-[calc(92vh-13rem)] w-auto max-w-full rounded-xl bg-abyss-950"
        controls
        playsinline
        preload="none"></video>
      <p id="clip-note" class="mt-4 text-sm leading-relaxed text-foam-400"></p>
    </div>
  </dialog>
</Section>

<script define:vars={{ sources: clips.map((c) => ({ src: media(c.file), local: `/${c.file}`, label: c.label, note: c.note })) }}>
  const dialog = document.getElementById('clip-dialog');
  const player = document.getElementById('clip-player');
  const title = document.getElementById('clip-dialog-title');
  const note = document.getElementById('clip-note');

  if (dialog && player) {
    const close = () => {
      dialog.close();
      // иначе ролик продолжает играть за закрытым окном и тянет трафик
      player.pause();
      player.removeAttribute('src');
      player.load();
    };

    document.querySelectorAll('[data-clip]').forEach((button) => {
      button.addEventListener('click', () => {
        const clip = sources[Number(button.dataset.clip)];
        if (!clip) return;
        title.textContent = clip.label;
        note.textContent = clip.note;
        // копия ролика лежит и в самом сайте: если на CDN его ещё нет,
        // плеер молча переключится на неё, а не покажет пустой прямоугольник
        player.dataset.local = clip.local;
        player.dataset.fallbackUsed = '';
        player.src = clip.src;
        dialog.showModal();
        player.play().catch(() => {});
      });
    });

    player.addEventListener('error', () => {
      const local = player.dataset.local;
      if (!local || player.dataset.fallbackUsed) return;
      player.dataset.fallbackUsed = '1';
      player.src = local;
      player.load();
      player.play().catch(() => {});
    });

    dialog.querySelector('[data-clip-close]')?.addEventListener('click', close);
    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
    });

    dialog.addEventListener('click', (e) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
      if (outside) close();
    });
  }
</script>
