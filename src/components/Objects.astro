---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import ships from '../assets/obj-ships.webp';
import special from '../assets/obj-special.webp';
import platforms from '../assets/obj-platforms.webp';
import bridges from '../assets/obj-bridges.webp';
import piers from '../assets/obj-piers.webp';
import propeller from '../assets/obj-propeller.webp';

const items = [
  { img: ships, label: 'Суда', note: 'Корпус ниже ватерлинии, винто-рулевая группа, кингстонные решётки' },
  { img: special, label: 'Спецтехника', note: 'Баржи, понтоны, плавкраны, буксиры' },
  { img: platforms, label: 'Платформы', note: 'Опорные колонны и подводные конструкции' },
  { img: bridges, label: 'Мосты', note: 'Опоры и подводные части пролётных строений' },
  { img: piers, label: 'Пирсы', note: 'Причальные стенки, сваи, отбойные устройства' },
  {
    img: propeller,
    label: 'Винты и рулевые устройства',
    note: 'Полировка винта и очистка дейдвуда: обрастание здесь бьёт по КПД сильнее всего',
  },
];
---

<Section
  id="objects"
  eyebrow="Где работаем"
  title="Всё, что стоит в воде и обрастает"
  lead="Одна технология закрывает и торговый флот, и портовую инфраструктуру: работа не зависит от водолазов и идёт там, где погружение человека дорого или опасно."
>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((it, i) => (
      <li
        class:list={[
          'group relative overflow-hidden rounded-2xl border border-white/10 bg-abyss-900',
          i === 0 && 'sm:col-span-2 lg:row-span-2',
        ]}
      >
        <Image
          src={it.img}
          alt={it.label}
          widths={[420, 840, 1200]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class:list={[
            'w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]',
            i === 0 ? 'h-64 lg:h-full lg:min-h-[26rem]' : 'h-52',
          ]}
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-abyss-950 via-abyss-950/30 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-5">
          <p class="text-lg font-semibold">{it.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-foam-300">{it.note}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>
