---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated?: string;
}
const { title, description, heading, updated } = Astro.props;
---

<Base title={title} description={description}>
  <Header />
  <main id="main" class="mx-auto max-w-3xl px-5 pt-32 pb-24 lg:px-8">
    <h1 class="text-[length:var(--text-display)] leading-tight font-bold tracking-tight text-balance">
      {heading}
    </h1>
    {updated && (
      <p class="mt-4 text-sm text-foam-500">
        Редакция от <time datetime={updated}>{new Date(updated).toLocaleDateString('ru-RU')}</time>
      </p>
    )}

    <div
      class="mt-12 space-y-6 leading-relaxed text-foam-300
             [&_a]:text-signal-500 [&_a]:underline [&_a]:underline-offset-2
             [&_h2]:mt-12 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-foam-100
             [&_li]:pl-1 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6
             [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
    >
      <slot />
    </div>
  </main>
  <Footer />
</Base>
